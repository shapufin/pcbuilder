{
  "PostToolUse": [
    {
      "matcher": "edit|write|notebook_edit",
      "hooks": [
        { "type": "command", "command": "node scripts/track-event.mjs", "timeout": 5 }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        { "type": "command", "command": "node scripts/track-event.mjs", "timeout": 5 }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        { "type": "command", "command": "node scripts/track-event.mjs", "timeout": 5 }
      ]
    }
  ]
}
