{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URI",
        "PAYLOAD_SECRET",
        "BMR_URL",
        "NEXT_BUILD_CPUS",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DATABASE_URI",
        "PAYLOAD_SECRET",
        "BMR_URL",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "STAFF_ALERT_EMAIL",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN"
      ]
    }
  }
}
