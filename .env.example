# --- Core ---
BMR_URL=http://localhost:3000

# --- Payload ---
PAYLOAD_SECRET=change-me-32-chars-minimum-random
# Postgres (production parity; run `docker compose up -d` first)
# DATABASE_URI=postgres://buildmyrig:buildmyrig@localhost:5432/buildmyrig
# SQLite (zero-setup local dev fallback)
DATABASE_URI=file:./payload.db

# --- Stripe (Phase 1) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email / Resend (Phase 1) ---
RESEND_API_KEY=
EMAIL_FROM=orders@buildmyrig.com
# Staff inbox for low-stock alerts + contact form (entry 23; falls back to
# EMAIL_FROM for /api/contact, skipped entirely when unset)
STAFF_ALERT_EMAIL=

# --- Storage / S3 (Phase 3) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Rate limiting (Phase 4) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Monitoring (Phase 4) ---
SENTRY_DSN=
SENTRY_ENV=local

# --- Analytics (Phase 3) ---
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
